# ==============================================================================
# DEFECT-GAN DOCKER ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env before running docker-compose:
#   cp .env.example .env

# Host path to GAN_Project directory (containing F971, S942, training manifests)
# On Linux host:
# DATA_DIR=/home/user/GAN_Project
# On Windows host (with Docker Desktop):
# DATA_DIR=D:/RTC/RD/GAN_Project
DATA_DIR=.

# Host path to outputs directory (for saving checkpoints, preview images, and logs)
OUTPUT_DIR=./outputs

# NVIDIA runtime device selection; CUDA_VISIBLE_DEVICES must use numeric IDs, never 'all'.
NVIDIA_VISIBLE_DEVICES=all
